{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "rootDir": ".",
        "baseUrl": "./",
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "rct": ["./src/index.ts", "./src/constants.ts"],
            "types": ["./src/types.d.ts"],
            "#*": ["./src/*"],
            "$*": ["./plugins/*"]
        },
        "types": ["bun-types"]
    },
    "include": ["src/**/*.ts", "plugins/**/*.ts", "test/*.ts"],
    "exclude": ["**/node_modules", "**/lib"]
}
